# ===========================================================================
# Copie este arquivo para .env e preencha. O .env não vai para o GitHub.
# Todas as variáveis abaixo são de fato lidas pelo código — nenhuma é decorativa.
# NUNCA coloque chave real neste arquivo de exemplo.
# ===========================================================================

# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL  (obrigatório)
# Exemplos:
#   Local:     postgresql://postgres:postgres@localhost:5432/banca
#   Neon:      postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#   Supabase:  postgresql://postgres.xxxx:pass@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banca"

# Conexões simultâneas no pool. Em serverless (Vercel), deixe baixo.
PG_POOL_MAX="5"

# ---------------------------------------------------------------------------
# Sessão e acesso  (obrigatório)
# ---------------------------------------------------------------------------
# Assina o cookie de sessão (HS256). Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa"

# Duração da sessão em horas (padrão: 168 = 7 dias)
SESSION_TTL_HOURS="168"

# Senha entregue a um integrante novo e usada na recuperação de acesso.
# Quem entra com ela é obrigado a escolher outra antes de ver qualquer tela.
DEFAULT_USER_PASSWORD="FZN2026"

# Nome e e-mail do dono da banca. Usados só pelo seed inicial (npm run db:seed).
SEED_OWNER_NAME="César"
SEED_OWNER_EMAIL="dono@banca.local"

# ---------------------------------------------------------------------------
# Workers  (protegem as rotas que gastam quota)
# ---------------------------------------------------------------------------
# Sem segredo, /api/workers/* recusa tudo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_SECRET=""

# Segredo específico dos bilhetes. Vazio = usa WORKER_SECRET.
TIPS_WORKER_SECRET=""

# Endereço público do app, usado pelo worker externo (scripts/sports-worker.ts).
APP_URL="http://localhost:3000"

# Intervalo do worker externo em milissegundos (padrão: 300000 = 5 min).
SPORTS_WORKER_INTERVAL_MS="300000"

# ===========================================================================
# CENTRAL DE DICAS — provedores de dados esportivos
#
# O aplicativo funciona INTEIRO sem nenhuma chave. Sem elas, o modo mock gera
# partidas, estatísticas e odds simuladas: dá para desenvolver e testar tudo
# sem gastar um único crédito.
# ===========================================================================

# mock = dados simulados (padrão, não gasta nada)
# live = usa as chaves abaixo; sem nenhuma chave, cai no simulador e avisa
DATA_PROVIDER_MODE="mock"

# ---------------------------------------------------------------------------
# API-Football  —  https://dashboard.api-football.com
# Fonte primária: calendário, jogos ao vivo, placar, minuto, estatísticas.
#
# Onde pegar: entre no dashboard, abra o menu da conta (ícone de pessoa na
# barra estreita da esquerda) e copie o valor de "API KEY".
#
# Gratuito: 100 requisições por dia, 10 por minuto, todas as ligas inclusas.
# O sistema respeita esse teto sozinho e entra em economia antes de estourar.
#
# ATENÇÃO: use a chave do acesso DIRETO (api-sports.io), não a do RapidAPI.
# ---------------------------------------------------------------------------
API_FOOTBALL_KEY=""

# ---------------------------------------------------------------------------
# The Odds API  —  https://the-odds-api.com
# Cotações reais e comparação entre casas de apostas.
#
# Gratuito: 500 créditos por MÊS. Cada chamada custa
# (nº de mercados × nº de regiões); listar os jogos custa zero.
# ---------------------------------------------------------------------------
THE_ODDS_API_KEY=""

# Regiões das casas, separadas por vírgula: eu | uk | us | au
# Cada região adicional MULTIPLICA o custo em créditos. Deixe uma só.
THE_ODDS_API_REGIONS="eu"

# ---------------------------------------------------------------------------
# Sportmonks  —  https://my.sportmonks.com   (OPCIONAL)
# Enriquecimento complementar. O sistema funciona bem sem ele.
#
# ATENÇÃO ao plano gratuito: libera apenas 7 competições — Superliga
# dinamarquesa, Premiership escocesa (e play-offs) e três de críquete.
# Não cobre futebol brasileiro nem as grandes ligas europeias. Se a sua
# cobertura é essa, deixe em branco: o sistema não perde nada.
# ---------------------------------------------------------------------------
SPORTMONKS_API_KEY=""

# ---------------------------------------------------------------------------
# Comportamento das Dicas
# ---------------------------------------------------------------------------
# true = ao abrir a aba, atualiza o que estiver vencido (respeitando cooldown).
# false = só o worker atualiza. Use false se a quota estiver apertada.
SPORTS_REFRESH_ON_VIEW="true"

# true = registra no log cada chamada a provedor (sem nenhum segredo).
SPORTS_LOG_DEBUG="false"

# ---------------------------------------------------------------------------
# BILHETES — fontes públicas, nenhuma chave de API
# ---------------------------------------------------------------------------
# Slugs das fontes ativas, separados por vírgula. Vazio = todas as cadastradas.
BILHETES_SOURCES=""

# Intervalo mínimo entre duas visitas à mesma fonte, em horas.
# O combinado com as fontes é no máximo 1 requisição por dia; 6h é o piso
# técnico para reprocessar sem baixar a página de novo.
BILHETES_SOURCE_COOLDOWN_HOURS="6"

# Identificação enviada no User-Agent. Mantenha um contato válido.
BILHETES_USER_AGENT="BancaBilhetes/1.0 (+contato via administrador)"
