# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL
# Exemplos:
#   Local:     postgresql://postgres:postgres@localhost:5432/banca
#   Neon:      postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/banca?sslmode=require
#   Supabase:  postgresql://postgres.xxxx:pass@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banca"

# Segredo usado para assinar o cookie de sessão (HS256).
# Gere um novo com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-este-valor-por-uma-chave-aleatoria-longa"

# Duração da sessão em horas (padrão: 168 = 7 dias)
SESSION_TTL_HOURS="168"

# ---------------------------------------------------------------------------
# Contas de acesso
# O seed cria cesar1014 (dono), ryang e lucastqa com a senha padrão abaixo e
# exige a troca no primeiro acesso. "Esqueci a senha" usa nick + senha padrão.
# ---------------------------------------------------------------------------
DEFAULT_USER_PASSWORD="FZN2026"
SEED_OWNER_NAME="César"
SEED_OWNER_EMAIL="cesar1014@banca.local"

# ---------------------------------------------------------------------------
# Central de Dicas — provedores de dados esportivos
#
# DATA_PROVIDER_MODE=mock  → simulação completa, nenhuma API é chamada (padrão)
# DATA_PROVIDER_MODE=live  → usa as chaves abaixo; sem nenhuma chave, cai no mock
#
# Nunca coloque chaves reais em arquivos versionados. As chaves ficam só no
# servidor: o navegador nunca as recebe.
# ---------------------------------------------------------------------------
DATA_PROVIDER_MODE="mock"

# API-Football (api-sports.io) — calendário, ao vivo, estatísticas, eventos, odds.
# Plano gratuito: 100 requests/dia, 10/min.
API_FOOTBALL_KEY=""

# Sportmonks (v3) — enriquecimento de estatísticas.
# Plano gratuito: Superliga (Dinamarca) e Premiership (Escócia); sem xG.
SPORTMONKS_API_KEY=""

# The Odds API (v4) — cotações de várias casas.
# Plano gratuito: 500 créditos/mês (1 crédito por mercado × região por chamada).
THE_ODDS_API_KEY=""
# Regiões consultadas (eu, uk, us, au). Cada região multiplica o custo.
THE_ODDS_API_REGIONS="eu"

# Segredo do worker (/api/workers/sports). Mínimo de 16 caracteres.
WORKER_SECRET=""
# URL do app para o script `npm run sports:worker` (padrão http://localhost:3000)
APP_URL="http://localhost:3000"

# Atualização sob demanda ao abrir as páginas de dicas (true/false).
# Com um worker/cron configurado, pode desligar para poupar quota.
SPORTS_REFRESH_ON_VIEW="true"
# Logs detalhados da camada esportiva (true/false)
SPORTS_LOG_DEBUG="false"

# ---------------------------------------------------------------------------
# Bilhetes — múltiplas de fontes públicas
# A coleta roda pelo worker /api/workers/bilhetes (cron) ou pelo botão do
# administrador. As páginas leem só o banco.
# ---------------------------------------------------------------------------
# Segredo do worker de bilhetes (se vazio, usa WORKER_SECRET)
TIPS_WORKER_SECRET=""
# Lista de fontes a coletar (vazio = todas as ativas): apostasepalpites,aposta10,predictlix,mightytips,apwin
BILHETES_SOURCES=""
# Intervalo mínimo entre coletas da mesma fonte, em horas (padrão 6 → no máximo 2/dia com o cron sugerido)
BILHETES_SOURCE_COOLDOWN_HOURS="6"
# User-Agent enviado às fontes (identifique o app)
BILHETES_USER_AGENT="BancaBilhetes/1.0 (+contato via administrador)"
