# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL
# Exemplos:
#   Local:     postgresql://postgres:postgres@localhost:5432/banca
#   Neon:      postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/banca?sslmode=require
#   Supabase:  postgresql://postgres.xxxx:pass@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banca"

# Segredo usado para assinar o cookie de sessão (HS256).
# Gere um novo com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-este-valor-por-uma-chave-aleatoria-longa"

# Duração da sessão em horas (padrão: 168 = 7 dias)
SESSION_TTL_HOURS="168"

# ---------------------------------------------------------------------------
# Acesso ao sistema
# ---------------------------------------------------------------------------
# Senha entregue a um integrante novo e usada na recuperação de acesso.
# Quem entra com ela é obrigado a escolher outra antes de ver qualquer tela.
DEFAULT_USER_PASSWORD="FZN2026"

# Apelido do dono da banca — a única conta que altera meta e banca inicial.
OWNER_USERNAME="cesar1014"

# Nome exibido do dono, usado só pelo seed inicial (npm run db:seed)
SEED_OWNER_NAME="César"

# ===========================================================================
# CENTRAL DE DICAS — provedores de dados esportivos
#
# O aplicativo funciona INTEIRO sem nenhuma chave configurada. Sem elas, o
# modo mock gera partidas, estatísticas e odds simuladas — dá para desenvolver
# e testar tudo sem gastar um único crédito.
# ===========================================================================

# mock = dados simulados (padrão, não gasta nada)
# live = usa as chaves abaixo
DATA_PROVIDER_MODE="mock"

# ---------------------------------------------------------------------------
# API-Football  —  https://dashboard.api-football.com
# Fonte primária: calendário, jogos ao vivo, placar, minuto, estatísticas, odds.
#
# Onde pegar a chave: entre no dashboard, abra o menu da conta (ícone de
# pessoa na barra estreita da esquerda) e copie o valor de "API KEY".
#
# Plano gratuito: 100 requisições por dia, 10 por minuto — todas as ligas e
# todos os endpoints inclusos. O sistema respeita esse teto sozinho.
#
# ATENÇÃO: use a chave do acesso DIRETO (api-sports.io), não a do RapidAPI.
# ---------------------------------------------------------------------------
API_FOOTBALL_KEY=""

# Teto diário do seu plano. Só mexa se assinar um plano pago.
API_FOOTBALL_DAILY_LIMIT="100"

# ---------------------------------------------------------------------------
# The Odds API  —  https://the-odds-api.com
# Cotações e comparação entre casas de apostas.
#
# Plano gratuito: 500 créditos por MÊS. O custo de cada chamada é
# (nº de mercados × nº de regiões), então uma consulta com 2 mercados e 1
# região custa 2 créditos. Buscar os jogos (/events) custa zero.
# ---------------------------------------------------------------------------
THE_ODDS_API_KEY=""
THE_ODDS_API_MONTHLY_CREDITS="500"

# Região das casas de apostas: eu | uk | us | au
# Cada região adicional MULTIPLICA o custo em créditos. Deixe uma só.
THE_ODDS_API_REGION="eu"

# ---------------------------------------------------------------------------
# Sportmonks  —  https://my.sportmonks.com
# Enriquecimento avançado. OPCIONAL — o sistema funciona bem sem ele.
#
# ATENÇÃO ao plano gratuito: cobre apenas DUAS ligas (Superliga dinamarquesa
# e Scottish Premiership), e NÃO inclui odds nem xG. Para futebol brasileiro
# ou europeu, o free não serve. Deixe em branco se não tiver plano pago.
# ---------------------------------------------------------------------------
SPORTMONKS_API_KEY=""

# Ligue só se você assinou os add-ons correspondentes. Com "false", o sistema
# nem tenta buscar — economiza chamada e evita erro que não é erro.
SPORTMONKS_HAS_ODDS="false"
SPORTMONKS_HAS_XG="false"

# ---------------------------------------------------------------------------
# Cobertura acompanhada
# ---------------------------------------------------------------------------
# IDs de liga da API-Football. Vazio usa o padrão:
#   71 Brasileirão A · 72 Série B · 13 Libertadores · 11 Sul-Americana
#   39 Premier League · 140 La Liga · 135 Serie A · 78 Bundesliga
#   61 Ligue 1 · 2 Champions · 3 Europa League
TRACKED_LEAGUE_IDS=""

# Chaves de esporte da The Odds API. Vazio usa o padrão equivalente.
TRACKED_ODDS_SPORTS=""

# ---------------------------------------------------------------------------
# Worker de atualização
# ---------------------------------------------------------------------------
# Segredo que protege /api/dicas/refresh. SEM ELE a rota recusa tudo — um
# endpoint que gasta quota não pode ficar aberto na internet.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TIPS_WORKER_SECRET=""

# Intervalo mínimo entre dois ciclos de atualização, em segundos.
TIPS_REFRESH_COOLDOWN_SECONDS="60"

# ---------------------------------------------------------------------------
# Ajuste fino do motor de análise (opcional)
# ---------------------------------------------------------------------------
# Peso do modelo próprio contra a probabilidade do mercado, em basis points.
# 3500 = 35% modelo, 65% mercado. Subir isto sem histórico que justifique é a
# forma mais rápida de gerar dicas ruins.
TIPS_MODEL_WEIGHT_BPS="3500"

# Quantas partidas passam por cada etapa do funil. Aumentar = gastar mais API.
TIPS_PIPELINE_SCREENED="60"
TIPS_PIPELINE_MONITORED="12"
TIPS_PIPELINE_ENRICHED="6"
TIPS_PIPELINE_PRICED="4"
